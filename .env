# # ChatGLM本地服务地址
# CHATGLM_URL=http://0.0.0.0:8002/chat

# --- 邮件通知配置 ---
SMTP_SERVER=smtp.example.com       # 你的邮箱SMTP服务器地址 (例如 smtp.qq.com, smtp.163.com)
SMTP_PORT=587                      # SMTP端口 (常用 587 for TLS, 465 for SSL)
SMTP_USERNAME=your_email@example.com # 你的发件邮箱地址
SMTP_PASSWORD=your_email_password_or_app_password # 你的邮箱密码或应用专用密码
EMAIL_RECIPIENT=recipient@example.com # 接收通知的邮箱地址